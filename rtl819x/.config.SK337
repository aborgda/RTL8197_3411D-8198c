# Reproducible SK337 build configuration
CONFIG_BOARD_rtl8198C_8954E=y
CONFIG_LINUX_3.10=y
CONFIG_BZBOX_busybox-1.13=y
CONFIG_RSDK_msdk-4.4.7-mips-EB-3.10-0.9.33-m32t-131227b=y
CONFIG_MODEL_SK337=y
CONFIG_ARCH_CPU_TYPE="mips"
CONFIG_ARCH_32BIT=y
CONFIG_ARCH_CPU_MIPS=y
CONFIG_ARCH_CPU_MIPS1074K=y
CONFIG_ARCH_CPU_EB=y
CONFIG_ARCH_IRQ_GIC=y
CONFIG_ARCH_CACHE_WBC=y
CONFIG_ARCH_BUS_PCI=y
CONFIG_RTL_819X=y
CONFIG_RTL_8198C=y
CONFIG_LINUXDIR=linux-3.10
CONFIG_BOARDDIR=boards/rtl8198C_8954E
CONFIG_BZBOXDIR=users/busybox-1.13
CONFIG_RSDKDIR=toolchain/msdk-4.4.7-mips-EB-3.10-0.9.33-m32t-131227b
CONFIG_MODEL=SK337
CONFIG_ROUTER=
CONFIG_ROOTFS_SQUASH=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZMA=y
CONFIG_RTL819X_SPI_FLASH=y
CONFIG_SPI_3to4BYTES_ADDRESS_SUPPORT=y
CONFIG_RTL_DEF_SETTING_IN_FW=y
CONFIG_RTL_WEBPAGES_IN_ROOTFS=y
CONFIG_RTL_NEW_GPIO_API=y
CONFIG_RTL_FLASH_MAPPING_ENABLE=y
CONFIG_RTL_FLASH_SIZE=0x2000000
CONFIG_RTL_HW_SETTING_OFFSET=0x20000
CONFIG_RTL_DEFAULT_SETTING_OFFSET=0x24000
CONFIG_RTL_CURRENT_SETTING_OFFSET=0x2a000
CONFIG_RTL_WEB_PAGES_OFFSET=0x30000
CONFIG_RTL_LINUX_IMAGE_OFFSET=0x60000
CONFIG_RTL_ROOT_IMAGE_OFFSET=0x1a0000
